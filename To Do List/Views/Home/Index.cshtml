@{
    ViewData["Title"] = "Home Page";
}

<div class="hero-wrapper">
    <section class="hero-card">
        <h1>Welcome to ToDoListApp</h1>
        <p class="lead">
        Organize your tasks, manage deadlines, and track your progress effortlessly.
        Our app helps you stay productive and focused every day.
        </p>
        <a href="/ToDoList/Index" class="btn btn-gradient btn-lg">View Your Tasks</a>

        <div class="features">
        <p><strong>Why use ToDoListApp?</strong> Because keeping track of your daily tasks shouldn't be a hassle. With our clean and simple interface, you can add, edit, and delete tasks with ease.</p>
        <p><strong>Stay on top of deadlines:</strong> The app highlights urgent tasks so you never miss important deadlines. You can filter by date and quickly see what's due soon.</p>
        <p><strong>File attachments:</strong> Upload files to your tasks and access them directly from the app. Everything is organized in one place for maximum efficiency.</p>
        </div>
    </section>
</div>
