@model ToDoList

<div class="container d-flex justify-content-center my-5">
    <div class="col-12 col-lg-8">

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <div class="row mb-4 align-items-center">
                    <div class="col-12">
                        <h2 class="h3 mb-0">Update Task</h2>
                    </div>
                </div>

                <form method="post" enctype="multipart/form-data">

                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input type="text"
                               id="title"
                               name="Tiltle"
                               class="form-control"
                               value="@Model.Tiltle" />
                    </div>

                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea id="description"
                                  name="Description"
                                  class="form-control"
                                  placeholder="Enter task description"
                                  style="height: 100px">@Model.Description</textarea>
                    </div>

                    <div class="mb-3">
                        <label for="deadline" class="form-label">Deadline</label>
                        <input type="datetime-local"
                               id="deadline"
                               class="form-control" 
                               name="Deadline"
                               value="@Model.Deadline.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Current File</label>

                        @if (Model.FileUrl != null)
                        {
                            <div class="alert alert-info d-flex align-items-center" role="alert">
                                <i class="bi bi-file-earmark-image me-2"></i>
                                <span>
                                    Current file:
                                    <a href="~/images/@Model.FileUrl" target="_blank" width="50">Open</a>
                                    /
                                    <a href="~/images/@Model.FileUrl" download>Download</a>
                                </span>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-secondary">No file uploaded.</div>
                        }
                    </div>

                    <div class="mb-4">
                        <label for="file" class="form-label">File</label>
                        <input type="file"
                               id="file"
                               name="formFile"
                               class="form-control"
                               value="@Model.FileUrl" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle"></i> Submit
                        </button>

                        <a href="/ToDoList/Index" class="btn btn-secondary">
                            Cancel
                        </a>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>